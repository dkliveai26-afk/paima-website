# ============================================================
# PAIMA Atelier — Production & Vercel Environment Variables Template
# Copy this file to .env.local for local development.
# Configure these exact variable names in your Vercel Project Settings.
# NEVER commit real secret values to version control.
# ============================================================

# ------------------------------------------------------------
# 1. Base Application URL
# Production domain: https://paimadesign.com
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://paimadesign.com

# ------------------------------------------------------------
# 2. MongoDB Database (https://www.mongodb.com/atlas)
# Production: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/paima_atelier
# ------------------------------------------------------------
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/paima_atelier

# ------------------------------------------------------------
# 3. Clerk Public Authentication (https://dashboard.clerk.com)
# ------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_YOUR_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_live_YOUR_CLERK_SECRET_KEY

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ------------------------------------------------------------
# 4. Private Admin Portal Authorization & JWT Security
# ADMIN_EMAIL: Authorized admin email list (comma-separated if multiple)
# ADMIN_PASSWORD: Real password required to access /dilkhush-admin
# ADMIN_JWT_SECRET: High-entropy secret key for signing admin JWT cookies
# ------------------------------------------------------------
ADMIN_EMAIL=admin@paimadesign.com
NEXT_PUBLIC_ADMIN_EMAIL=admin@paimadesign.com
ADMIN_PASSWORD=YOUR_SECURE_ADMIN_PASSWORD
ADMIN_JWT_SECRET=YOUR_64_CHARACTER_RANDOM_SECRET_KEY

# ------------------------------------------------------------
# 5. AI API Keys (OpenAI / Google Gemini)
# Powers the PAIMA Agent chat concierge & spatial recommendations
# ------------------------------------------------------------
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ------------------------------------------------------------
# 6. SMTP Email Notifications (Gmail / SendGrid / Custom SMTP)
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=concierge@paimadesign.com
SMTP_PASS=YOUR_SMTP_APP_PASSWORD
EMAIL_FROM="PAIMA Concierge Atelier" <concierge@paimadesign.com>

# ------------------------------------------------------------
# 7. Google Maps API (Optional — for address autocomplete)
# ------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
