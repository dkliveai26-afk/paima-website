# ============================================================
# PAIMA Atelier — Environment Variables Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ============================================================

# ------------------------------------------------------------
# Clerk Authentication (https://dashboard.clerk.com)
# ------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_KEY

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ------------------------------------------------------------
# MongoDB Database
# Local: mongodb://127.0.0.1:27017/paima_atelier
# Atlas: mongodb+srv://user:password@cluster.mongodb.net/paima_atelier
# ------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/paima_atelier

# ------------------------------------------------------------
# Admin Authorization
# The Gmail address(es) allowed to access /dilkhush-admin
# Checked server-side on every admin API call — cannot be spoofed.
# Multiple admins: ADMIN_EMAIL=admin1@gmail.com,admin2@gmail.com
# ------------------------------------------------------------
ADMIN_EMAIL=your-admin-email@gmail.com

# Client-side Clerk guard — must match ADMIN_EMAIL (comma-separated)
NEXT_PUBLIC_ADMIN_EMAIL=your-admin-email@gmail.com

# ------------------------------------------------------------
# Google Maps API Key (optional — used for address autocomplete)
# ------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
